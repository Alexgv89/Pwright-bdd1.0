{
  "name": "Pwright-bdd1.0",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm run pw:run",
    "test:chromium": "pnpm run pw:run -- --project=chromium",
    "test:firefox": "pnpm run pw:run -- --project=firefox",
    "test:webkit": "pnpm run pw:run -- --project=webkit",
    "pw:run": "allure run --config ./allurerc.mjs -- playwright test",
    "bdd:gen": "bddgen",
    "clean:results": "rimraf allure-results allure-report",
    "clean:history": "rimraf allure-history",
    "clean:all": "rimraf allure-results allure-report allure-history test-results",
    "report": "playwright show-report",
    "report:allure": "allure generate --config ./allurerc.mjs ./allure-results -o ./allure-report",
    "report:single": "allure awesome --config ./allurerc.mjs ./allure-results --single-file -o ./allure-report",
    "report:single:open": "allure open --config ./allurerc.mjs ./allure-report",
    "report:single:ci": "allure generate --config ./allurerc.mjs ./allure-results -o ./allure-report && allure open --config ./allurerc.mjs ./allure-report",
    "report:ci": "allure open --config ./allurerc.mjs ./allure-report",
    "quality-gate": "allure quality-gate --config ./allurerc.mjs ./allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^26.6.2",
    "allure": "^3.19.1",
    "allure-playwright": "^3.12.2",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.2.1",
    "rimraf": "^6.1.3"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0"
}
