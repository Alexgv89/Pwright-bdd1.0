{
  "name": "Pwright-bdd1.0",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm pw:run",
    "test:chromium": "pnpm pw:run -- --project=chromium",
    "test:firefox": "pnpm pw:run -- --project=firefox",
    "test:webkit": "pnpm pw:run -- --project=webkit",
    "pw:run": "pnpm exec allure run --config ./allurerc.mjs -- pnpm exec playwright test",
    "bdd:gen": "pnpm exec bddgen",
    "clean:results": "pnpm exec rimraf allure-results allure-report",
    "clean:history": "pnpm exec rimraf allure-history",
    "clean:all": "pnpm exec rimraf allure-results allure-report allure-history test-results",
    "report": "pnpm exec playwright show-report",
    "report:allure": "pnpm exec allure generate --config ./allurerc.mjs ./allure-results -o ./allure-report",
    "report:allure:open": "pnpm exec allure open --config ./allurerc.mjs ./allure-report",
    "report:single": "pnpm exec allure awesome --config ./allurerc.mjs ./allure-results --single-file -o ./allure-report",
    "report:single:open": "pnpm exec allure open --config ./allurerc.mjs ./allure-report",
    "report:single:flow": "pnpm exec allure awesome --config ./allurerc.mjs ./allure-results --single-file -o ./allure-report && pnpm exec allure open --config ./allurerc.mjs ./allure-report",
    "quality-gate": "pnpm exec allure quality-gate --config ./allurerc.mjs ./allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "allure": "3.19.1",
    "allure-playwright": "3.12.2",
    "dotenv": "16.4.7",
    "playwright-bdd": "9.2.1",
    "rimraf": "6.1.3"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0"
}
